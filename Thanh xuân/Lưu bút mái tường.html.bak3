        // Tinh so hoa ca nhan nguoi dung da tang cho tung Thay Co
        function getMyTeacherGiftCount(teacherObj) {
            if (!currentUser || !currentUser.name) return 0;
            const myName = currentUser.name.trim().toLowerCase();
            const tFullName = (typeof teacherObj === 'string' ? teacherObj : teacherObj.name).toLowerCase();
            const keywords = [tFullName];
            if (typeof teacherObj === 'object') {
                if (teacherObj.id === 'minh') keywords.push('thầy minh', 'hiệu trưởng minh', 'nguyễn văn minh', 'minh');
                else if (teacherObj.id === 'mai') keywords.push('cô mai', 'nguyễn thị mai', 'mai');
                else if (teacherObj.id === 'nam') keywords.push('thầy nam', 'trần hoàng nam', 'nam');
                else if (teacherObj.id === 'trang') keywords.push('cô trang', 'lê thu trang', 'trang');
                else if (teacherObj.id === 'anh') keywords.push('thầy anh', 'phạm tuấn anh', 'tuấn anh');
                else if (teacherObj.id === 'ngocanh') keywords.push('cô ngọc anh', 'đỗ ngọc anh', 'ngọc anh');
            }
            return memories.filter(m => {
                if (m.type !== 'teacher') return false;
                const author = (m.name || '').trim().toLowerCase();
                if (!author || author !== myName) return false;
                const target = (m.teacherName || '').trim().toLowerCase();
                return keywords.some(k => target.includes(k) || k.includes(target));
            }).length;
        }

        // Tinh tong so hoa ca nhan nguoi dung da gui tang tat ca Thay Co
        function getMyTotalGiftedCount() {
            if (!currentUser || !currentUser.name) return 0;
            const myName = currentUser.name.trim().toLowerCase();
            return memories.filter(m => {
                if (m.type !== 'teacher') return false;
                const author = (m.name || '').trim().toLowerCase();
                return Boolean(author && author === myName);
            }).length;
        }

        function renderTeacherCards() {
            const grid = document.getElementById('teachersGrid');
            if (!grid) return;
            grid.innerHTML = '';

            CUTE_TEACHERS.forEach(t => {
                // Chi hien thi so hoa ma chinh nguoi dung hien tai da gui tang Thay/Co nay
                const myTeacherGifts = getMyTeacherGiftCount(t);
                const statHtml = myTeacherGifts > 0
                    ? `<div class="teacher-flower-stat personal-gifted">
                           <svg width="14" height="14" viewBox="0 0 24 24" fill="#e03131" style="vertical-align: -2px; margin-right: 4px;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                           Bạn đã gửi tặng: <strong>${myTeacherGifts}</strong> bông hoa
                       </div>`
                    : `<div class="teacher-flower-stat personal-empty">
                           Bạn chưa gửi tặng hoa cho ${t.name.startsWith('Cô') ? 'Cô' : 'Thầy'}
                       </div>`;

                const card = document.createElement('div');
                card.className = 'teacher-cute-card';
                card.style.background = t.bg;
                card.style.borderColor = t.border;
                card.innerHTML = `
                    <div>
                        <div class="teacher-avatar-circle" style="background: ${t.avatarColor}20; color: ${t.avatarColor};">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                                ${t.iconSvg}
                            </svg>
                        </div>
                        <div class="teacher-card-name">${t.name}</div>
                        <span class="teacher-subject-badge" style="background: ${t.tagBg}; color: ${t.tagColor};">${t.subject}</span>
                        <div class="teacher-quote-box">"${t.quote}"</div>
                    </div>
                    <div>
                        ${statHtml}
                        <button type="button" class="btn-gift-teacher-card" data-teacher="${t.name}">
                            Gửi Bó Hoa Tri Ân
                        </button>
                    </div>
                `;

                const btnGift = card.querySelector('.btn-gift-teacher-card');
                btnGift.addEventListener('click', () => {
                    selectTeacherToGift(t.name);
                });

                grid.appendChild(card);
            });
        }

        function selectTeacherToGift(teacherName) {
            const privateRadio = document.querySelector('input[name="teacherSendType"][value="private"]');
            if (privateRadio) {
                privateRadio.checked = true;
                privateRadio.dispatchEvent(new Event('change'));
            }
            const privMsgRadio = document.querySelector('input[name="teacherPrivacy"][value="private"]');
            if (privMsgRadio) {
                privMsgRadio.checked = true;
                privMsgRadio.dispatchEvent(new Event('change'));
            }
            if (targetTeacherNameInput) {
                targetTeacherNameInput.value = teacherName;
            }

            const alertBox = document.getElementById('targetTeacherAlert');
            const alertName = document.getElementById('targetTeacherAlertName');
            if (alertBox && alertName) {
                alertName.textContent = teacherName + ' (Kèm lời nhắn riêng)';
                alertBox.style.display = 'flex';
            }

            // Cuộn xuống khu vực chọn hoa và lời chúc
            const picker = document.getElementById('flowerPicker');
            if (picker) {
                picker.scrollIntoView({ behavior: 'smooth' });
            }
        }

        const btnResetTargetTeacher = document.getElementById('btnResetTargetTeacher');
        if (btnResetTargetTeacher) {
            btnResetTargetTeacher.addEventListener('click', () => {
                const publicRadio = document.querySelector('input[name="teacherSendType"][value="public"]');
                if (publicRadio) {
                    publicRadio.checked = true;
                    publicRadio.dispatchEvent(new Event('change'));
                }
                const pubMsgRadio = document.querySelector('input[name="teacherPrivacy"][value="public"]');
                if (pubMsgRadio) {
                    pubMsgRadio.checked = true;
                    pubMsgRadio.dispatchEvent(new Event('change'));
                }
                const alertBox = document.getElementById('targetTeacherAlert');
                if (alertBox) alertBox.style.display = 'none';
            });
        }


        // ================= CẤU HÌNH VÀ KẾT NỐI FIREBASE BACKEND =================
        const firebaseConfig = {
            apiKey: "AIzaSyBTzOvrkLBLLwCp92vCPwr19gaa3GPUUkk",
            authDomain: "luubutmaitruong.firebaseapp.com",
            databaseURL: "https://luubutmaitruong-default-rtdb.firebaseio.com",
            projectId: "luubutmaitruong",
            storageBucket: "luubutmaitruong.firebasestorage.app",
            messagingSenderId: "478975164360",
            appId: "1:478975164360:web:9ad178daf6a25d1845cafd",
            measurementId: "G-M4T4PPFYV9"
        };

        let firebaseApp = null;
        let firebaseAuth = null;
        let firebaseDb = null;
        let firebaseAnalytics = null;
        let currentAuthUser = null;
        let isLocalAdmin = false;

        if (typeof firebase !== 'undefined') {
            try {
                firebaseApp = firebase.initializeApp(firebaseConfig);
                firebaseAuth = firebase.auth();
                firebaseDb = firebase.database();
                try {
                    firebaseAnalytics = firebase.analytics();
                } catch (e) {
                    console.log('Firebase Analytics note:', e.message);
                }
            } catch (err) {
                console.warn('Firebase init note:', err);
            }
        }

        // Lắng nghe dữ liệu thời gian thực từ Firebase Realtime Database
        if (firebaseDb) {
            const memoriesRef = firebaseDb.ref('memories');
            memoriesRef.on('value', (snapshot) => {
                const remoteList = [];
                snapshot.forEach((child) => {
                    const item = child.val();
                    if (item) remoteList.push(item);
                });
                if (remoteList.length > 0) {
                    memories = remoteList;
                    memories.sort((a, b) => (b.id || 0) - (a.id || 0));
                    const activeTab = document.querySelector('.tab-btn.active');
                    renderMemories(activeTab ? activeTab.dataset.filter : 'all');
                    renderTeacherCards();
                    updateFlowerCounter();
                }
            }, (error) => {
                console.warn('Firebase RTDB note:', error);
            });
        }

        let isAdmin = false;
        let searchQuery = '';
        let currentPostImage = null; // Ảnh đính kèm bài viết

        // Lightbox xem ảnh phóng to
        window.openLightbox = function(src) {
            const lb = document.getElementById('imageLightbox');
            const img = document.getElementById('lightboxImg');
            if (lb && img) {
                img.src = src;
                lb.style.display = 'flex';
            }
        };
        window.closeLightbox = function() {
            const lb = document.getElementById('imageLightbox');
            if (lb) lb.style.display = 'none';
        };

        const adminLoginBtn = document.getElementById('adminLoginBtn');
        const openAuthModalBtn = document.getElementById('openAuthModalBtn');
        const closeAuthModalBtn = document.getElementById('closeAuthModalBtn');
        const authModal = document.getElementById('authModal');
        const authLoggedInView = document.getElementById('authLoggedInView');
        const authLoggedOutView = document.getElementById('authLoggedOutView');
        const authCurrentUserEmail = document.getElementById('authCurrentUserEmail');
        const tabEmailAuthBtn = document.getElementById('tabEmailAuthBtn');
        const tabPinAuthBtn = document.getElementById('tabPinAuthBtn');
        const firebaseEmailForm = document.getElementById('firebaseEmailForm');
        const pinAuthForm = document.getElementById('pinAuthForm');
        const btnCreateAdminFirebase = document.getElementById('btnCreateAdminFirebase');
        const authSignOutBtn = document.getElementById('authSignOutBtn');

        // Hàm bảo mật: Băm SHA-256 kiểm tra mật khẩu PIN nội bộ
        async function hashPassword(str) {
            const buffer = new TextEncoder().encode(str);
            const digest = await crypto.subtle.digest('SHA-256', buffer);
            return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
        }

        function openAuthModal() {
            if (authModal) authModal.style.display = 'flex';
        }
        function closeAuthModal() {
            if (authModal) authModal.style.display = 'none';
        }

        if (openAuthModalBtn) openAuthModalBtn.addEventListener('click', openAuthModal);
        if (closeAuthModalBtn) closeAuthModalBtn.addEventListener('click', closeAuthModal);
        if (adminLoginBtn) adminLoginBtn.addEventListener('click', openAuthModal);
        if (authModal) {
            authModal.addEventListener('click', (e) => {
                if (e.target === authModal) closeAuthModal();
            });
        }

        function setAdminPillStatus(text, isLoggedIn) {
            if (!openAuthModalBtn) return;
            openAuthModalBtn.innerHTML = `
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 4px;">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                </svg>
                <span>${text}</span>
            `;
            if (isLoggedIn) openAuthModalBtn.classList.add('logged-in');
            else openAuthModalBtn.classList.remove('logged-in');
        }

        // Cập nhật giao diện trạng thái Đăng nhập / Quản trị
        function updateAuthUI(isLoggedIn, emailOrName) {
            if (isLoggedIn) {
                setAdminPillStatus('Quản Trị (Bật)', true);
                if (adminLoginBtn) {
                    adminLoginBtn.textContent = 'Quản Trị: ' + (emailOrName || 'Đang Bật') + ' (Bấm để quản lý)';
                }
                if (authLoggedInView) authLoggedInView.style.display = 'block';
                if (authLoggedOutView) authLoggedOutView.style.display = 'none';
                if (authCurrentUserEmail) authCurrentUserEmail.textContent = emailOrName || 'Quản trị viên';
            } else {
                setAdminPillStatus('Đăng Nhập Quản Trị', false);
                if (adminLoginBtn) {
                    adminLoginBtn.textContent = 'Đăng Nhập Quản Trị Hệ Thống';
                }
                if (authLoggedInView) authLoggedInView.style.display = 'none';
                if (authLoggedOutView) authLoggedOutView.style.display = 'block';
            }
        }

        // Lắng nghe trạng thái Firebase Authentication
        if (firebaseAuth) {
            firebaseAuth.onAuthStateChanged((user) => {
                if (user) {
                    isAdmin = true;
                    currentAuthUser = user;
                    updateAuthUI(true, user.email || 'Quản trị viên');
                } else {
                    if (!isLocalAdmin) {
                        isAdmin = false;
                        currentAuthUser = null;
                        updateAuthUI(false);
                    }
                }
                const activeTab = document.querySelector('.tab-btn.active');
                renderMemories(activeTab ? activeTab.dataset.filter : 'all');
            });
        }

        // Chuyển tab trong modal đăng nhập
        if (tabEmailAuthBtn && tabPinAuthBtn) {
            tabEmailAuthBtn.addEventListener('click', () => {
                tabEmailAuthBtn.classList.add('active');
                tabPinAuthBtn.classList.remove('active');
                firebaseEmailForm.style.display = 'block';
                pinAuthForm.style.display = 'none';
            });
            tabPinAuthBtn.addEventListener('click', () => {
                tabPinAuthBtn.classList.add('active');
                tabEmailAuthBtn.classList.remove('active');
                firebaseEmailForm.style.display = 'none';
                pinAuthForm.style.display = 'block';
            });
        }

        // Đăng nhập Firebase Auth (Email & Password)
        if (firebaseEmailForm) {
            firebaseEmailForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const email = document.getElementById('authEmailInput').value.trim();
                const pass = document.getElementById('authPasswordInput').value;
                if (!email || !pass) return;

                if (!firebaseAuth) {
                    alert('Firebase SDK chưa sẵn sàng. Bạn có thể chuyển sang tab "Mã PIN Nhanh" để đăng nhập.');
                    return;
                }

                firebaseAuth.signInWithEmailAndPassword(email, pass)
                    .then((cred) => {
                        alert('Đăng nhập Firebase thành công! Quyền quản trị đã được kích hoạt.');
                        closeAuthModal();
                    })
                    .catch((err) => {
                        alert('Đăng nhập thất bại: ' + (err.message || 'Sai tài khoản hoặc mật khẩu.'));
                    });
            });
        }

        // Tạo tài khoản Quản trị Firebase
        if (btnCreateAdminFirebase) {
            btnCreateAdminFirebase.addEventListener('click', () => {
                const email = document.getElementById('authEmailInput').value.trim();
                const pass = document.getElementById('authPasswordInput').value;
                if (!email || !pass) {
                    alert('Vui lòng nhập Email và Mật khẩu (tối thiểu 6 ký tự) để đăng ký tài khoản Quản trị viên.');
                    return;
                }
                if (pass.length < 6) {
                    alert('Mật khẩu Firebase cần có ít nhất 6 ký tự.');
                    return;
                }
                if (!firebaseAuth) {
                    alert('Firebase SDK chưa sẵn sàng.');
                    return;
                }

                firebaseAuth.createUserWithEmailAndPassword(email, pass)
                    .then((cred) => {
                        alert('Đăng ký tài khoản Quản trị Firebase thành công!');
                        closeAuthModal();
                    })
                    .catch((err) => {
                        alert('Không thể tạo tài khoản: ' + err.message);
                    });
            });
        }

        // Đăng nhập bằng Mã PIN bảo mật dự phòng
        if (pinAuthForm) {
            pinAuthForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const pin = document.getElementById('authPinInput').value;
                const hashed = await hashPassword(pin);
                if (hashed === '82b13d78d9ae75cc36694f67e7ec91c71e4d3b20294f6bb3861a7884ab0ac400') {
                    isLocalAdmin = true;
                    isAdmin = true;
                    updateAuthUI(true, 'Quản Trị Viên (Mã PIN)');
                    closeAuthModal();
                    const activeTab = document.querySelector('.tab-btn.active');
                    renderMemories(activeTab ? activeTab.dataset.filter : 'all');
                    alert('Đăng nhập thành công! Chế độ Quản trị đã được bật.');
                } else {
                    alert('Sai mã PIN quản trị!');
                }
            });
        }

        // Đăng xuất
        if (authSignOutBtn) {
            authSignOutBtn.addEventListener('click', () => {
                if (firebaseAuth && firebaseAuth.currentUser) {
                    firebaseAuth.signOut().then(() => {
                        isLocalAdmin = false;
                        isAdmin = false;
                        updateAuthUI(false);
                        closeAuthModal();
                        alert('Đã đăng xuất khỏi hệ thống!');
                    }).catch(err => alert('Lỗi đăng xuất: ' + err.message));
                } else {
                    isLocalAdmin = false;
                    isAdmin = false;
                    updateAuthUI(false);
                    closeAuthModal();
                    const activeTab = document.querySelector('.tab-btn.active');
                    renderMemories(activeTab ? activeTab.dataset.filter : 'all');
                    alert('Đã thoát chế độ Quản trị viên!');
                }
            });
        }

        // Phím tắt '1' mở modal quản trị nhanh
        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
            if (e.key === '1') {
                openAuthModal();
            }
        });

        window.deleteMemory = function(uniqueCode) {
            showCuteConfirm(
                'Xác Nhận Xóa',
                'Bạn có chắc chắn muốn xóa bài viết này không?\nHành động này sẽ xóa vĩnh viễn khỏi hệ thống và không thể hoàn tác.',
                function() {
                    if (typeof firebase !== 'undefined' && firebase.database) {
                        firebase.database().ref('memories/' + uniqueCode).remove()
                            .then(function() {
                                showCuteAlert('Thông Báo', 'Đã xóa bài viết thành công!');
                            })
                            .catch(function(err) {
                                showCuteAlert('Lỗi', 'Lỗi xóa bài: ' + (err.message || err));
                            });
                    } else {
                        memories = memories.filter(m => m.uniqueCode !== uniqueCode);
                        const activeTab = document.querySelector('.tab-btn.active');
                        renderMemories(activeTab ? activeTab.dataset.filter : 'all');
                        renderTeacherCards();
                        updateFlowerCounter();
                        showCuteAlert('Thông Báo', 'Đã xóa bài viết thành công!');
                    }
                }
            );
        };

        // Lắng nghe tìm kiếm
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.toLowerCase();
            const activeTab = document.querySelector('.tab-btn.active');
            renderMemories(activeTab ? activeTab.dataset.filter : 'all');
        });

        // CẤU HÌNH TELEGRAM BOT (Được mã hóa an toàn tránh bot crawler tự động cào token)
        const TELEGRAM_BOT_TOKEN = atob('ODU0NTMyMDY0NDpBQUdIcl9RUGF4d2JfYzdNRXJQU3J1WnlLeE9OWm1RaWRhUQ==');
        const TELEGRAM_CHAT_ID = atob('ODczOTQzNzMxNw=='); 

        function escapeTelegramHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function sendToTelegram(memory) {
            if (!TELEGRAM_CHAT_ID || TELEGRAM_CHAT_ID === 'YOUR_TELEGRAM_CHAT_ID_HERE') {
                return;
            }
            let title = '<b>CÓ TÙY BÚT MỚI!</b>';
            let extra = '';
            if (memory.type === 'teacher') {
                title = '<b>LỜI CHÚC TRI ÂN THẦY CÔ MỚI!</b>';
                extra = `<b>Người nhận:</b> ${escapeTelegramHtml(memory.teacherName)}\n` +
                        `<b>Tặng hoa:</b> ${escapeTelegramHtml(memory.flower)}\n`;
            }
            if (memory.image) {
                extra += `<b>Hình ảnh:</b> [Có đính kèm ảnh kỷ niệm]\n`;
            }

            const message = `${title}\n\n` +
                            `<b>Người gửi:</b> ${escapeTelegramHtml(memory.name)}\n` +
                            `<b>Niên khóa:</b> ${escapeTelegramHtml(memory.batch)}\n` +
                            `<b>Vai trò:</b> ${escapeTelegramHtml(memory.roleName || 'Học sinh')}\n` +
                            extra +
                            `<b>Mã cá nhân:</b> ${escapeTelegramHtml(memory.uniqueCode)}\n` +
                            `<b>Thời gian:</b> ${escapeTelegramHtml(memory.date)}\n\n` +
                            `<b>Nội dung:</b>\n${escapeTelegramHtml(memory.content)}`;

            fetch(`https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    chat_id: TELEGRAM_CHAT_ID,
                    text: message,
                    parse_mode: 'HTML'
                })
            }).catch(error => console.error("Lỗi gửi Telegram:", error));
        }

        function generateUniqueCode(batch) {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = '';
            for(let i=0; i<4; i++) code += chars.charAt(Math.floor(Math.random() * chars.length));
            return (batch || 'K') + '-' + code;
        }

        // ----------------- XỬ LÝ ĐÍNH KÈM ẢNH BÀI VIẾT -----------------
        const triggerPostImageBtn = document.getElementById('triggerPostImageBtn');
        const postImageInput = document.getElementById('postImageInput');
        const postImagePreviewContainer = document.getElementById('postImagePreviewContainer');
        const postImagePreviewImg = document.getElementById('postImagePreviewImg');
        const removePostImageBtn = document.getElementById('removePostImageBtn');
        const attachFromBoothBtn = document.getElementById('attachFromBoothBtn');

        triggerPostImageBtn.addEventListener('click', () => postImageInput.click());

        function compressImage(fileOrImg, callback) {
            const img = new Image();
            const reader = new FileReader();
            reader.onload = (e) => {
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    let width = img.width;
                    let height = img.height;
                    const maxDim = 800;
                    if (width > maxDim || height > maxDim) {
                        if (width > height) {
                            height = Math.round((height * maxDim) / width);
                            width = maxDim;
                        } else {
                            width = Math.round((width * maxDim) / height);
                            height = maxDim;
                        }
                    }
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');

        // ================= POPUP CUTE THONG BAO (THAY THE TOAN BO CHROME ALERT & CONFIRM) =================
        function showCuteAlert(title, message, callback) {
            const modal = document.getElementById('cuteModal');
            if (!modal) {
                if (typeof callback === 'function') callback();
                return;
            }
            const titleEl = document.getElementById('cuteModalTitle');
            const msgEl = document.getElementById('cuteModalMessage');
            const inputCont = document.getElementById('cuteModalInputContainer');
            const btnCancel = document.getElementById('cuteModalBtnCancel');
            const btnOk = document.getElementById('cuteModalBtnOk');

            if (titleEl) titleEl.textContent = title || 'Nhật Ký Thanh Xuân';
            if (msgEl) msgEl.textContent = message || '';
            if (inputCont) inputCont.style.display = 'none';
            if (btnCancel) btnCancel.style.display = 'none';
            if (btnOk) {
                btnOk.textContent = 'Đã Hiểu';
                btnOk.className = 'cute-modal-btn cute-modal-btn-ok';
            }

            modal.style.display = 'flex';

            btnOk.onclick = function() {
                modal.style.display = 'none';
                btnOk.onclick = null;
                if (typeof callback === 'function') callback();
            };
        }

        function showCuteConfirm(title, message, onConfirm, onCancel) {
            const modal = document.getElementById('cuteModal');
            if (!modal) {
                if (typeof onConfirm === 'function') onConfirm();
                return;
            }
            const titleEl = document.getElementById('cuteModalTitle');
            const msgEl = document.getElementById('cuteModalMessage');
            const inputCont = document.getElementById('cuteModalInputContainer');
            const btnCancel = document.getElementById('cuteModalBtnCancel');
            const btnOk = document.getElementById('cuteModalBtnOk');

            if (titleEl) titleEl.textContent = title || 'Xác Nhận';
            if (msgEl) msgEl.textContent = message || '';
            if (inputCont) inputCont.style.display = 'none';
            if (btnCancel) {
                btnCancel.style.display = 'inline-block';
                btnCancel.textContent = 'Bỏ qua';
            }
            if (btnOk) {
                btnOk.textContent = 'Đồng Ý';
                btnOk.className = 'cute-modal-btn cute-modal-btn-ok cute-modal-btn-danger';
            }

            modal.style.display = 'flex';

            btnOk.onclick = function() {
                modal.style.display = 'none';
                btnOk.onclick = null;
                if (btnCancel) btnCancel.onclick = null;
                if (typeof onConfirm === 'function') onConfirm();
            };

            if (btnCancel) {
                btnCancel.onclick = function() {
                    modal.style.display = 'none';
                    btnOk.onclick = null;
                    btnCancel.onclick = null;
                    if (typeof onCancel === 'function') onCancel();
                };
            }
        }

        function showCutePrompt(title, message, placeholder, onConfirm, onCancel) {
            const modal = document.getElementById('cuteModal');
            if (!modal) {
                if (typeof onConfirm === 'function') onConfirm('');
                return;
            }
            const titleEl = document.getElementById('cuteModalTitle');
            const msgEl = document.getElementById('cuteModalMessage');
            const inputCont = document.getElementById('cuteModalInputContainer');
            const inputEl = document.getElementById('cuteModalInput');
            const btnCancel = document.getElementById('cuteModalBtnCancel');
            const btnOk = document.getElementById('cuteModalBtnOk');

            if (titleEl) titleEl.textContent = title || 'Xác Thực';
            if (msgEl) msgEl.textContent = message || '';
            if (inputCont) inputCont.style.display = 'block';
            if (inputEl) {
                inputEl.value = '';
                inputEl.placeholder = placeholder || 'Nhập tại đây...';
            }
            if (btnCancel) {
                btnCancel.style.display = 'inline-block';
                btnCancel.textContent = 'Hủy bỏ';
            }
            if (btnOk) {
                btnOk.textContent = 'Mở Thư';
                btnOk.className = 'cute-modal-btn cute-modal-btn-ok';
            }

            modal.style.display = 'flex';
            if (inputEl) setTimeout(() => inputEl.focus(), 150);

            btnOk.onclick = function() {
                const val = inputEl ? inputEl.value.trim() : '';
                modal.style.display = 'none';
                if (inputCont) inputCont.style.display = 'none';
                btnOk.onclick = null;
                if (btnCancel) btnCancel.onclick = null;
                if (typeof onConfirm === 'function') onConfirm(val);
            };

            if (btnCancel) {
                btnCancel.onclick = function() {
                    modal.style.display = 'none';
                    if (inputCont) inputCont.style.display = 'none';
                    btnOk.onclick = null;
                    btnCancel.onclick = null;
                    if (typeof onCancel === 'function') onCancel();
                };
            }
        }

        // Ghi de toan bo window.alert cua he thong bang Popup Cute
        window.alert = function(msg) {
            showCuteAlert('Nhật Ký Thanh Xuân', msg);
        };

                    ctx.drawImage(img, 0, 0, width, height);
                    const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.75);
                    callback(compressedDataUrl);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(fileOrImg);
        }

        postImageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                compressImage(file, (dataUrl) => {
                    currentPostImage = dataUrl;
                    postImagePreviewImg.src = dataUrl;
                    postImagePreviewContainer.style.display = 'inline-block';
                });
            }
        });

        removePostImageBtn.addEventListener('click', () => {
            currentPostImage = null;
            postImageInput.value = '';
            postImagePreviewContainer.style.display = 'none';
        });

        attachFromBoothBtn.addEventListener('click', () => {
            if (lastBoothPhoto) {
                currentPostImage = lastBoothPhoto;
                postImagePreviewImg.src = lastBoothPhoto;
                postImagePreviewContainer.style.display = 'inline-block';
                document.getElementById('writeSection').scrollIntoView({ behavior: 'smooth' });
            }
        });

        // SUBMIT FORM TÙY BÚT & ĐĂNG BÀI
        memoryForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const authorName = document.getElementById('authorName').value;
            const authorBatch = document.getElementById('authorBatch').value;
            const memoryContent = document.getElementById('memoryContent').value;
            const userRole = document.querySelector('input[name="userRole"]:checked').value;
            
            const roleName = userRole === 'hoc-sinh' ? 'Học sinh' : 'Cựu học sinh';
            const uniqueCode = generateUniqueCode(authorBatch);
            
            const now = new Date();
            const dateString = now.toLocaleDateString('vi-VN') + ' ' + now.toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});

            const memory = {
                id: Date.now(),
                type: 'memory',
                name: authorName,
                batch: authorBatch,
                uniqueCode: uniqueCode,
                role: userRole,
                roleName: roleName,
                content: memoryContent,
                image: currentPostImage || null,
                date: dateString
            };

            // Nếu đã kết nối Firebase
            if (typeof firebase !== 'undefined') {
                firebase.database().ref('memories/' + uniqueCode).set(memory);
            } else {
                // Lưu nội bộ tạm thời khi chưa có cấu hình
                memories.unshift(memory);
                renderMemories('all');
            }

            // Gửi báo cáo Telegram
            sendToTelegram(memory);

            alert(`Đã đăng bài kỷ niệm thành công!\n\nMã kỷ niệm của bạn là: ${uniqueCode}\n(Hãy lưu lại mã này để tìm lại bài viết nhé!)`);
            
            // Xóa form
            document.getElementById('authorName').value = '';
            document.getElementById('memoryContent').value = '';
            if (document.getElementById('authorBatch')) document.getElementById('authorBatch').value = '';
            currentPostImage = null;
            postImagePreviewContainer.style.display = 'none';
            postImageInput.value = '';
            
            // Chuyển tab về Tất cả
            tabBtns.forEach(b => b.classList.remove('active'));
            document.querySelector('.tab-btn[data-filter="all"]').classList.add('active');
        });

