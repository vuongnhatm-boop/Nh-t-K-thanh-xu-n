                    alert('Firebase SDK chưa sẵn sàng. Bạn có thể chuyển sang tab "Mã PIN Nhanh" để đăng nhập.');
                    return;
                }

                firebaseAuth.signInWithEmailAndPassword(email, pass)
                    .then((cred) => {
                        alert('Đăng nhập Firebase thành công! Quyền quản trị đã được kích hoạt.');
                        closeAuthModal();
