                { id: "flower_2", name: "Bó Hoa Hồng Phấn", tag: "20/11 Cảm ơn Thầy Cô", src: "flowers/flower_2.webp" },
                { id: "flower_3", name: "Bó Hoa Ly Trắng", tag: "Tri ân Thầy Cô", src: "flowers/flower_3.webp" },
                { id: "flower_4", name: "Bó Cẩm Tú Cầu Tím", tag: "20/11 Cảm ơn Thầy Cô", src: "flowers/flower_4.webp" },
                { id: "flower_5", name: "Bó Cẩm Chướng Hồng", tag: "20/11 Tri ân Thầy Cô", src: "flowers/flower_5.webp" },
                { id: "flower_6", name: "Bó Tulip Vàng", tag: "Cảm ơn Thầy Cô", src: "flowers/flower_6.webp" },
