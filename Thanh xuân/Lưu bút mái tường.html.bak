        // Cập nhật huy hiệu túi hoa của người dùng
        function updateUserFlowerBadge() {
            const badge = document.getElementById('userFlowerBadge');
            const text = document.getElementById('userFlowerStatusText');
            const earnLink = document.getElementById('earnFlowerLink');
            const balance = parseInt(localStorage.getItem('userFlowerBalance') || '0', 10);

            // Cập nhật huy hiệu trên thanh chào mừng
            const greetingPill = document.getElementById('greetingFlowerPill');
            if (greetingPill) {
                greetingPill.textContent = balance + ' bông hoa';
            }

            // Cập nhật huy hiệu trên thanh điều hướng tab
            const tabIndicator = document.getElementById('tabFlowerIndicator');
            if (tabIndicator) {
                tabIndicator.textContent = balance + ' hoa';
            }

            if (!badge || !text) return;

            if (balance > 0) {
                badge.className = 'user-flower-badge has-flowers';
                text.innerHTML = `Túi hoa của bạn: <strong>${balance}</strong> bông hoa sẵn sàng gửi tặng!`;
                if (earnLink) {
                    earnLink.textContent = 'Chụp thêm ảnh để nhận thêm hoa';
                    earnLink.onclick = (e) => { e.preventDefault(); switchZoneTab('photoboothSection'); };
                }
            } else {
                badge.className = 'user-flower-badge empty-flowers';
                text.innerHTML = `Túi hoa của bạn: <strong>0</strong> bông hoa (Chưa thể gửi tặng)`;
                if (earnLink) {
                    earnLink.textContent = 'Chụp 1 bức để nhận hoa!';
                    earnLink.onclick = (e) => { e.preventDefault(); switchZoneTab('photoboothSection'); };
                }
            }
        }

        // Tích lũy hoa khi người dùng chụp ảnh tại photobooth
        function earnFlower() {
            let balance = parseInt(localStorage.getItem('userFlowerBalance') || '0', 10);
            balance += 1;
            localStorage.setItem('userFlowerBalance', balance);
            updateUserFlowerBadge();

            setTimeout(() => {
                alert(`Chúc mừng! Bạn vừa chụp/tạo 1 bức ảnh thanh xuân và nhận được +1 bông hoa tri ân!\nHiện trong túi của bạn có: ${balance} bông hoa.\nHãy cuộn xuống mục "Tri Ân Thầy Cô" để gửi tặng Thầy Cô nhé!`);
            }, 300);
        }

        // Khởi tạo danh sách 10 mẫu hoa tri ân
        function setupFlowerPicker() {
            if (!flowerPicker || !window.TEACHER_FLOWERS) return;
            flowerPicker.innerHTML = '';

            TEACHER_FLOWERS.forEach((flower, idx) => {
                const card = document.createElement('div');
                card.className = 'flower-card' + (idx === 0 ? ' selected' : '');
                card.innerHTML = `
                    <img src="${flower.src}" class="flower-card-img" alt="${flower.name}">
                    <div class="flower-card-name">${flower.name}</div>
                    <span class="flower-card-tag">${flower.tag}</span>
                `;
                card.addEventListener('click', () => {
                    document.querySelectorAll('.flower-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    selectedFlowerObj = flower;
                });
                flowerPicker.appendChild(card);
            });
            selectedFlowerObj = TEACHER_FLOWERS[0];
        }

        document.querySelectorAll('input[name="teacherSendType"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                if (e.target.value === 'private') {
                    privateTeacherGroup.style.display = 'block';
                    targetTeacherNameInput.required = true;
                } else {
                    privateTeacherGroup.style.display = 'none';
                    targetTeacherNameInput.required = false;
                }
            });
        });

        function updateFlowerCounter() {
            if (!teacherFlowerTotalEl) return;
            const count = memories.filter(m => m.type === 'teacher' || m.flower).length;
            teacherFlowerTotalEl.textContent = count;
        }

        // Xử lý gửi tặng hoa và lời chúc
        teacherForm.addEventListener('submit', (e) => {
            e.preventDefault();

            let balance = parseInt(localStorage.getItem('userFlowerBalance') || '0', 10);
            if (balance <= 0) {
                alert('Bạn chưa có bông hoa nào trong túi!\n\nĐiều kiện: Bạn cần chụp 1 bức ảnh tại mục "Chụp Hình" phía trên để nhận 1 bông hoa tri ân tặng Thầy Cô nhé!');
                document.getElementById('photoboothSection').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            const senderName = document.getElementById('teacherSenderName').value.trim();
            const senderBatch = document.getElementById('teacherSenderBatch').value;
            const sendType = document.querySelector('input[name="teacherSendType"]:checked').value;
            const targetTeacher = sendType === 'private' ? (targetTeacherNameInput.value.trim() || 'Thầy/Cô') : 'Toàn thể Thầy Cô';
            const wishContent = document.getElementById('teacherWishContent').value.trim();
            const uniqueCode = generateUniqueCode(senderBatch);

            // Khấu trừ 1 bông hoa
            balance -= 1;
            localStorage.setItem('userFlowerBalance', balance);
            updateUserFlowerBadge();

            const flowerData = selectedFlowerObj || (window.TEACHER_FLOWERS ? window.TEACHER_FLOWERS[0] : { name: 'Bó Hoa Tri Ân', src: '' });

            const now = new Date();
            const dateString = now.toLocaleDateString('vi-VN') + ' ' + now.toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});

            const tribute = {
                id: Date.now(),
                type: 'teacher',
                name: senderName,
                batch: senderBatch,
                uniqueCode: uniqueCode,
                role: 'hoc-sinh',
                roleName: 'Học sinh',
                teacherType: sendType,
                teacherName: targetTeacher,
                flower: flowerData.name,
                flowerImg: flowerData.src,
                content: wishContent,
                date: dateString
            };

            if (typeof firebase !== 'undefined') {
                firebase.database().ref('memories/' + uniqueCode).set(tribute);
            } else {
                memories.unshift(tribute);
                renderMemories('all');
                updateFlowerCounter();
            }

            sendToTelegram(tribute);

            alert(`Đã gửi tặng [${flowerData.name}] tới ${targetTeacher} thành công!\nSố hoa còn lại trong túi của bạn: ${balance} bông.\nCảm ơn bạn đã luôn nhớ về công ơn Thầy Cô.`);

            // Xóa form
            document.getElementById('teacherSenderName').value = '';
            document.getElementById('teacherSenderBatch').value = '';
            document.getElementById('teacherWishContent').value = '';
            targetTeacherNameInput.value = '';
            document.querySelector('input[name="teacherSendType"][value="general"]').checked = true;
            privateTeacherGroup.style.display = 'none';

            // Cuộn xuống xem lời chúc
            document.getElementById('timelineSection').scrollIntoView({ behavior: 'smooth' });
        });

        // Khởi tạo hệ thống hoa
        
        // Khởi tạo người dùng & giao diện
        checkUserSession();
        renderTeacherCards();
        updateFlowerCounter();

        setupFlowerPicker();
        updateUserFlowerBadge();



        // Dự phòng nếu frames_data.js chưa load
        if (typeof BOOTH_FRAMES === 'undefined' || !window.BOOTH_FRAMES || !window.BOOTH_FRAMES.length) {
            window.BOOTH_FRAMES = [
                { id: "frame_1", name: "20/11 - Mèo Hồng & Nơ Xinh", width: 333, height: 360, aspectRatio: "333/360", src: "frames/frame_1.webp" },
                { id: "frame_2", name: "20/11 - Bảng Đen & Hướng Dương", width: 341, height: 360, aspectRatio: "341/360", src: "frames/frame_2.webp" },
                { id: "frame_3", name: "20/11 - Trời Xanh & Mây Trắng", width: 331, height: 360, aspectRatio: "331/360", src: "frames/frame_3.webp" },
                { id: "frame_4", name: "20/11 - Máy Ảnh & Phim Tím", width: 491, height: 308, aspectRatio: "491/308", src: "frames/frame_4.webp" },
                { id: "frame_5", name: "20/11 - Trái Tim & Nơ Đỏ", width: 514, height: 308, aspectRatio: "514/308", src: "frames/frame_5.webp" }
            ];
        }

        
        // ================= KHU VỰC CHỤP HÌNH PHOTOBOOTH =================
        let currentFrameIndex = 0;
        let loadedUserImg = null;
        let lastBoothPhoto = null;
        let boothStream = null;

        const cameraBox = document.getElementById('cameraBox');
        const cameraStage = document.getElementById('cameraStage');
        const cameraVideo = document.getElementById('cameraVideo');
        const cameraFrameOverlay = document.getElementById('cameraFrameOverlay');
        const cameraPlaceholder = document.getElementById('cameraPlaceholder');
        const userPhotoPreview = document.getElementById('userPhotoPreview');
        const countdownOverlay = document.getElementById('countdownOverlay');
        const flashOverlay = document.getElementById('flashOverlay');
        const fullscreenToolbar = document.getElementById('fullscreenToolbar');
        const fsFrameLabel = document.getElementById('fsFrameLabel');

        const frameSelector = document.getElementById('frameSelector');
        const boothCaptionInput = document.getElementById('boothCaptionInput');
        const startCameraBtn = document.getElementById('startCameraBtn');
        const captureBtn = document.getElementById('captureBtn');
        const fsCaptureBtn = document.getElementById('fsCaptureBtn');
        const uploadPhotoBtn = document.getElementById('uploadPhotoBtn');
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const fsCloseBtn = document.getElementById('fsCloseBtn');
        const fsPrevFrameBtn = document.getElementById('fsPrevFrameBtn');
        const fsNextFrameBtn = document.getElementById('fsNextFrameBtn');
        const boothFileInput = document.getElementById('boothFileInput');

        const boothCanvas = document.getElementById('boothCanvas');
        const boothCtx = boothCanvas.getContext('2d');
        const boothResultArea = document.getElementById('boothResultArea');
        const boothPreviewImg = document.getElementById('boothPreviewImg');
        const downloadPhotoBtn = document.getElementById('downloadPhotoBtn');
        const sendToPostBtn = document.getElementById('sendToPostBtn');
        const shareFacebookBtn = document.getElementById('shareFacebookBtn');

        // Khởi tạo bộ chọn khung ảnh
        function setupFrameSelector() {
            if (!frameSelector || !window.BOOTH_FRAMES) return;
            frameSelector.innerHTML = '';
            BOOTH_FRAMES.forEach((frame, idx) => {
                const card = document.createElement('div');
                card.className = 'frame-card' + (idx === currentFrameIndex ? ' active' : '');
                card.innerHTML = `
                    <img class="frame-card-thumb" src="${frame.src}" alt="${frame.name}">
                    <span class="frame-card-name">${frame.name}</span>
                `;
                card.addEventListener('click', () => {
                    document.querySelectorAll('.frame-card').forEach(c => c.classList.remove('active'));
                    card.classList.add('active');
                    currentFrameIndex = idx;
                    applyFrameSelection();
                });
                frameSelector.appendChild(card);
            });
            applyFrameSelection();
        }

        // Cập nhật khung ảnh hiển thị và chỉnh tỉ lệ khung ngắm
        function applyFrameSelection() {
            if (!window.BOOTH_FRAMES) return;
            const frame = BOOTH_FRAMES[currentFrameIndex];
            if (!frame) return;

            cameraFrameOverlay.src = frame.src;
            cameraFrameOverlay.style.display = 'block';
            cameraBox.style.aspectRatio = frame.aspectRatio;
            if (cameraStage) cameraStage.style.aspectRatio = frame.aspectRatio;

            if (fsFrameLabel) {
                fsFrameLabel.textContent = `Khung ${currentFrameIndex + 1}/${BOOTH_FRAMES.length}`;
            }

            if (loadedUserImg) {
                renderPhotobooth();
            }
        }

        // Chế độ Toàn Màn Hình
        function enterFullscreen() {
            const elem = cameraBox;
            if (!elem) return;
            if (elem.requestFullscreen) {
                elem.requestFullscreen();
            } else if (elem.webkitRequestFullscreen) {
                elem.webkitRequestFullscreen();
            } else if (elem.msRequestFullscreen) {
                elem.msRequestFullscreen();
            }
        }

        function exitFullscreen() {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
            } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
            }
        }

        if (fullscreenBtn) fullscreenBtn.addEventListener('click', enterFullscreen);
        if (fsCloseBtn) fsCloseBtn.addEventListener('click', exitFullscreen);

        if (fsPrevFrameBtn) {
            fsPrevFrameBtn.addEventListener('click', () => {
                currentFrameIndex = (currentFrameIndex - 1 + BOOTH_FRAMES.length) % BOOTH_FRAMES.length;
                document.querySelectorAll('.frame-card').forEach((c, idx) => {
                    c.classList.toggle('active', idx === currentFrameIndex);
                });
                applyFrameSelection();
            });
        }

        if (fsNextFrameBtn) {
            fsNextFrameBtn.addEventListener('click', () => {
                currentFrameIndex = (currentFrameIndex + 1) % BOOTH_FRAMES.length;
                document.querySelectorAll('.frame-card').forEach((c, idx) => {
                    c.classList.toggle('active', idx === currentFrameIndex);
                });
                applyFrameSelection();
            });
        }

        if (boothCaptionInput) {
            boothCaptionInput.addEventListener('input', () => {
                if (loadedUserImg) renderPhotobooth();
            });
        }

        // Dừng camera an toàn và giải phóng phần cứng
        function stopCamera() {
            if (boothStream) {
                try {
                    boothStream.getTracks().forEach(t => t.stop());
                } catch(e) {}
                boothStream = null;
            }
            if (cameraVideo) {
                cameraVideo.pause();
                cameraVideo.srcObject = null;
                cameraVideo.style.display = 'none';
            }
            if (captureBtn) captureBtn.style.display = 'none';
            if (fsCaptureBtn) fsCaptureBtn.style.display = 'none';
            if (startCameraBtn) startCameraBtn.textContent = 'Mở Camera';
        }

        // Khởi động Camera
        async function startCamera() {
            stopCamera();
            try {
                boothStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 960 } },
                    audio: false
                });
                cameraVideo.srcObject = boothStream;
                await cameraVideo.play();
                cameraVideo.style.display = 'block';
                userPhotoPreview.style.display = 'none';
                cameraPlaceholder.style.display = 'none';
                cameraFrameOverlay.style.display = 'block';
                captureBtn.style.display = 'inline-flex';
                if (fsCaptureBtn) fsCaptureBtn.style.display = 'inline-flex';
                startCameraBtn.textContent = 'Tắt Camera';

                applyFrameSelection();
            } catch (err) {
                alert('Không thể mở Camera (hoặc trình duyệt chưa cấp quyền). Bạn có thể bấm "Tải Ảnh Từ Máy" để chọn ảnh có sẵn nhé!');
                console.error('Lỗi Camera:', err);
                stopCamera();
            }
        }

        if (startCameraBtn) {
            startCameraBtn.addEventListener('click', async () => {
                if (boothStream) {
                    stopCamera();
                    if (loadedUserImg) {
                        userPhotoPreview.style.display = 'block';
                        cameraPlaceholder.style.display = 'none';
                    } else {
                        cameraPlaceholder.style.display = 'flex';
                    }
                } else {
                    await startCamera();
                }
            });
        }

        // Chụp ảnh với đếm ngược 3 giây
        function doCapture() {
            if (!cameraVideo || cameraVideo.readyState < 2 || cameraVideo.videoWidth === 0) {
                alert('Camera đang khởi động, vui lòng thử lại sau giây lát!');
                return;
            }

            let count = 3;
            countdownOverlay.textContent = count;
            countdownOverlay.style.display = 'block';

            const timer = setInterval(() => {
                count--;
                if (count > 0) {
                    countdownOverlay.textContent = count;
                } else {
                    clearInterval(timer);
                    countdownOverlay.style.display = 'none';
                    flashOverlay.style.opacity = '0.9';
                    setTimeout(() => flashOverlay.style.opacity = '0', 250);

                    const vw = cameraVideo.videoWidth || 640;
                    const vh = cameraVideo.videoHeight || 480;
                    const offCanvas = document.createElement('canvas');
                    offCanvas.width = vw;
                    offCanvas.height = vh;
                    const offCtx = offCanvas.getContext('2d');
                    offCtx.translate(vw, 0);
                    offCtx.scale(-1, 1);
                    offCtx.drawImage(cameraVideo, 0, 0, vw, vh);

                    // Giải phóng camera ngay sau khi chụp xong để không bị lỗi treo thiết bị
                    stopCamera();
                    startCameraBtn.textContent = 'Mở Camera Chụp Lại';

                    const snapImg = new Image();
                    snapImg.onload = () => {
                        loadedUserImg = snapImg;
                        userPhotoPreview.src = snapImg.src;
                        userPhotoPreview.style.display = 'block';
                        cameraPlaceholder.style.display = 'none';
                        cameraFrameOverlay.style.display = 'block';
                        renderPhotobooth();

                        boothResultArea.style.display = 'block';
                        const celebBox = document.getElementById('boothCelebBox');
                        if (celebBox) celebBox.style.display = 'block';
                        boothResultArea.scrollIntoView({ behavior: 'smooth' });

                        earnFlower();
                    };
                    snapImg.src = offCanvas.toDataURL('image/jpeg', 0.92);
                }
            }, 900);
        }

        if (captureBtn) captureBtn.addEventListener('click', doCapture);
        if (fsCaptureBtn) fsCaptureBtn.addEventListener('click', doCapture);

        // Tải ảnh từ máy tính
        if (uploadPhotoBtn && boothFileInput) {
            uploadPhotoBtn.addEventListener('click', () => boothFileInput.click());
            boothFileInput.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (evt) => {
                        const img = new Image();
                        img.onload = () => {
                            loadedUserImg = img;
                            userPhotoPreview.src = evt.target.result;
                            userPhotoPreview.style.display = 'block';
                            cameraPlaceholder.style.display = 'none';
                            cameraFrameOverlay.style.display = 'block';

                            stopCamera();
                            renderPhotobooth();
                            boothResultArea.style.display = 'block';
                            const celebBox = document.getElementById('boothCelebBox');
                            if (celebBox) celebBox.style.display = 'block';
                            boothResultArea.scrollIntoView({ behavior: 'smooth' });

                            earnFlower();
                        };
                        img.src = evt.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Hàm ghép ảnh người dùng vào khung (Canvas)
        function renderPhotobooth() {
            if (!loadedUserImg || !window.BOOTH_FRAMES) return;
            const frame = BOOTH_FRAMES[currentFrameIndex];
            if (!frame) return;

            const targetW = frame.width * 2;
            const targetH = frame.height * 2;
            boothCanvas.width = targetW;
            boothCanvas.height = targetH;
            boothCtx.clearRect(0, 0, targetW, targetH);

            drawUserImageBehindFrame(loadedUserImg, targetW, targetH);

            const frameImg = new Image();
            frameImg.onload = () => {
                boothCtx.drawImage(frameImg, 0, 0, targetW, targetH);

                const caption = boothCaptionInput ? boothCaptionInput.value.trim() : '';
                if (caption) {
                    boothCtx.save();
                    boothCtx.font = 'bold 24px "Dancing Script", cursive, sans-serif';
                    boothCtx.fillStyle = '#4a3b32';
                    boothCtx.textAlign = 'center';
                    boothCtx.shadowColor = 'rgba(255, 255, 255, 0.9)';
                    boothCtx.shadowBlur = 6;
                    boothCtx.fillText(caption, targetW / 2, targetH - 12);
                    boothCtx.restore();
                }

                const dataUrl = boothCanvas.toDataURL('image/jpeg', 0.92);
                lastBoothPhoto = dataUrl;
                boothPreviewImg.src = dataUrl;
                if (attachFromBoothBtn) attachFromBoothBtn.style.display = 'inline-block';
            };
            frameImg.src = frame.src;
        }

        function drawUserImageBehindFrame(img, targetW, targetH) {
            boothCtx.save();
            const imgRatio = img.width / img.height;
            const targetRatio = targetW / targetH;
            let srcX = 0, srcY = 0, srcW = img.width, srcH = img.height;

            if (imgRatio > targetRatio) {
                srcW = img.height * targetRatio;
                srcX = (img.width - srcW) / 2;
            } else {
                srcH = img.width / targetRatio;
                srcY = (img.height - srcH) / 2;
            }

            boothCtx.drawImage(img, srcX, srcY, srcW, srcH, 0, 0, targetW, targetH);
            boothCtx.restore();
        }

        // Nút hành động trong kết quả chụp ảnh
        if (downloadPhotoBtn) {
            downloadPhotoBtn.addEventListener('click', () => {
                if (!lastBoothPhoto) return;
                const link = document.createElement('a');
                link.download = `anh-ky-niem-20-11-${Date.now()}.jpg`;
                link.href = lastBoothPhoto;
                link.click();
            });
        }

        if (sendToPostBtn) {
            sendToPostBtn.addEventListener('click', () => {
                if (!lastBoothPhoto) return;
                currentPostImage = lastBoothPhoto;
                postImagePreviewImg.src = lastBoothPhoto;
                postImagePreviewContainer.style.display = 'inline-block';
                switchZoneTab('writeSection');
                document.getElementById('writeSection').scrollIntoView({ behavior: 'smooth' });
                alert('Đã đính kèm ảnh vừa tạo vào bài đăng! Hãy viết thêm lời chúc hoặc kỷ niệm và bấm "Lưu Lại Kỷ Niệm" nhé!');
            });
        }

        if (shareFacebookBtn) {
            shareFacebookBtn.addEventListener('click', () => {
                if (!lastBoothPhoto) return;
                const link = document.createElement('a');
                link.download = `anh-ky-niem-20-11-${Date.now()}.jpg`;
                link.href = lastBoothPhoto;
                link.click();

                window.open('https://www.facebook.com/', '_blank');
                alert('Ảnh kỷ niệm đã được tải xuống máy của bạn! Trang Facebook vừa được mở ở tab mới để bạn đăng ảnh nhé!');
            });
        }

        // Hành động nhanh: Chọn hoa và tặng Thầy Cô ngay
        const btnQuickGiftTeacher = document.getElementById('btnQuickGiftTeacher');
        if (btnQuickGiftTeacher) {
            btnQuickGiftTeacher.addEventListener('click', () => {
                if (lastBoothPhoto) {
                    currentPostImage = lastBoothPhoto;
                }
                switchZoneTab('teacherSection');
                const flowerPicker = document.getElementById('flowerPicker');
                if (flowerPicker) flowerPicker.scrollIntoView({ behavior: 'smooth' });
                alert('Bức ảnh vừa tạo đã sẵn sàng! Bạn hãy chọn 1 bó hoa tươi thắm và gửi gắm lời chúc tới Thầy Cô nhé!');
            });
        }

        const btnQuickAddToMemory = document.getElementById('btnQuickAddToMemory');
        if (btnQuickAddToMemory) {
            btnQuickAddToMemory.addEventListener('click', () => {
                if (lastBoothPhoto) {
                    currentPostImage = lastBoothPhoto;
                    postImagePreviewImg.src = lastBoothPhoto;
                    postImagePreviewContainer.style.display = 'inline-block';
                }
                switchZoneTab('writeSection');
                document.getElementById('writeSection').scrollIntoView({ behavior: 'smooth' });
                alert('Đã đính kèm ảnh kỷ niệm vào bài viết! Hãy viết thêm những dòng lưu bút đáng nhớ nhé!');
            });
        }

        // Khởi tạo bộ chọn khung ảnh ngay khi tải xong
        setupFrameSelector();


        // ----------------- HIỂN THỊ DANH SÁCH BÀI ĐĂNG (TIMELINE) -----------------
        // Hàm chống tấn công mã độc XSS
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderMemories(filter = 'all') {
            let filteredMemories = memories;
            
            // Lọc theo tab
            if (filter === 'memory') {
                filteredMemories = filteredMemories.filter(m => m.type !== 'teacher');
            } else if (filter === 'teacher') {
                filteredMemories = filteredMemories.filter(m => m.type === 'teacher');
            } else if (filter === 'has-image') {
                filteredMemories = filteredMemories.filter(m => Boolean(m.image));
            } else if (filter === 'hoc-sinh' || filter === 'cuu-hoc-sinh') {
                filteredMemories = filteredMemories.filter(m => m.role === filter);
            }
            
            // Lọc theo từ khóa tìm kiếm
            if (searchQuery.trim() !== '') {
                filteredMemories = filteredMemories.filter(m => 
                    (m.name && m.name.toLowerCase().includes(searchQuery)) ||
                    (m.uniqueCode && m.uniqueCode.toLowerCase().includes(searchQuery)) ||
                    (m.content && m.content.toLowerCase().includes(searchQuery)) ||
                    (m.batch && m.batch.toLowerCase().includes(searchQuery)) ||
                    (m.teacherName && m.teacherName.toLowerCase().includes(searchQuery)) ||
                    (m.date && m.date.toLowerCase().includes(searchQuery))
                );
            }
            
            if (filteredMemories.length === 0) {
                memoryTimeline.innerHTML = '<div id="emptyMessage" style="text-align: center; color: var(--ink-light); font-style: italic; margin-top: 20px;">Không tìm thấy kỷ niệm nào phù hợp.</div>';
                return;
            }

            memoryTimeline.innerHTML = '';
            
            filteredMemories.forEach(memory => {
                const item = document.createElement('div');
                item.className = 'timeline-item';
                item.dataset.role = memory.role || 'hoc-sinh';
                
                const safeName = escapeHtml(memory.name);
                const safeRoleName = escapeHtml(memory.roleName || 'Học sinh');
                const safeRoleClass = (memory.role === 'cuu-hoc-sinh') ? 'cuu-hoc-sinh' : 'hoc-sinh';
                const safeBatch = escapeHtml(memory.batch || '');
                const safeCode = escapeHtml(memory.uniqueCode || 'N/A');
                const safeDate = escapeHtml(memory.date);
                const safeContent = escapeHtml(memory.content).replace(/\n/g, '<br>');

                // Huy hiệu và bó hoa tri ân thầy cô nếu có
                let teacherBadgeHtml = '';
                if (memory.type === 'teacher') {
                    const safeTeacher = escapeHtml(memory.teacherName || 'Toàn thể Thầy Cô');
                    const safeFlower = escapeHtml(memory.flower || 'Hoa Tri Ân');
                    const flowerImgTag = memory.flowerImg ? `<img src="${memory.flowerImg}" class="tribute-flower-thumb" alt="${safeFlower}">` : '';
                    teacherBadgeHtml = `
                        <div style="margin-top: 10px; display: flex; gap: 14px; align-items: center; background: #fffcf5; padding: 10px 14px; border-radius: 12px; border: 1px dashed var(--yellow);">
                            ${flowerImgTag}
                            <div>
                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px;">
                                    <span class="teacher-badge">Kính gửi: ${safeTeacher}</span>
                                    <span class="flower-gift-badge">Đã trao tặng: ${safeFlower}</span>
                                </div>
                                <div style="font-size: 0.88em; color: var(--ink-light); font-style: italic;">Bó hoa tri ân nhân ngày Nhà Giáo Việt Nam 20/11</div>
                            </div>
                        </div>
                    `;
                }

                // Hình ảnh đính kèm nếu có
                let imageHtml = '';
                if (memory.image) {
                    imageHtml = `
                        <div>
                            <img src="${memory.image}" class="timeline-image" onclick="openLightbox(this.src)" title="Bấm vào để xem ảnh phóng to" alt="Ảnh kỷ niệm">
                        </div>
                    `;
                }

                let deleteBtnHtml = '';
                if (isAdmin) {
                    deleteBtnHtml = `<div style="text-align: right; margin-top: 10px; border-top: 1px dashed var(--pink-light); padding-top: 10px;"><button onclick="deleteMemory('${safeCode}')" style="background: var(--red); color: white; border: none; padding: 4px 10px; border-radius: 5px; cursor: pointer; font-size: 0.85em; font-family: var(--font-body); font-weight: 600;">Xóa bài này</button></div>`;
                }
                
                item.innerHTML = `
                    <div class="timeline-author" style="flex-wrap: wrap;">
                        <span class="timeline-author-name">${safeName}</span>
                        <span class="role-tag role-${safeRoleClass}">${safeRoleName}</span>
                        <span class="role-tag" style="background: var(--pink-light); color: var(--ink); margin-left: 5px;">${safeBatch}</span>
                        <span style="margin-left: auto; font-family: monospace; color: var(--ink-light); font-size: 0.9em; padding: 2px 6px; border: 1px dashed var(--pink); border-radius: 4px; background: var(--paper);">ID: ${safeCode}</span>
                    </div>
                    ${teacherBadgeHtml}
                    <span class="timeline-date-time">${safeDate}</span>
                    <div class="timeline-text">${safeContent}</div>
                    ${imageHtml}
                    ${deleteBtnHtml}
                `;
                
                memoryTimeline.appendChild(item);
                observeNewItem(item);
            });
        }

        // Lọc tùy bút
        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                tabBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderMemories(btn.dataset.filter);
            });
        });

        // ----------------- TRÌNH PHÁT NHẠC (PLAYLIST) -----------------
        const songs = [
            { title: "Mùa Hè Của Peppa (Khi anh chạy về phía em)", src: "Mùa hè của peppa( 当我飞奔向你 - Ost Khi anh chạy về phía em.mp3" },
            { title: "Người Gieo Mầm Xanh (Piano Cover)", src: "Người Gieo Mầm Xanh - Piano Cover - Hùng Music.mp3" },
            { title: "Có Hẹn Với Thanh Xuân (Piano Cover)", src: "Có Hẹn Với Thanh Xuân - MONSTAR -- Piano Cover -- AnCoong.mp3" }
        ];
        
        let currentSongIndex = 0;
        const bgMusic = document.getElementById('bgMusic');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const playlistEl = document.getElementById('playlist');
        const diskIcon = document.getElementById('diskIcon');
        let hasInteracted = false;

        function loadSong(index) {
            bgMusic.src = songs[index].src;
            renderPlaylist();
        }

        function renderPlaylist() {
            playlistEl.innerHTML = '';
            songs.forEach((song, index) => {
                const li = document.createElement('li');
                li.textContent = `${index + 1}. ${song.title}`;
                if (index === currentSongIndex) li.classList.add('active');
                li.addEventListener('click', () => {
                    currentSongIndex = index;
                    loadSong(currentSongIndex);
                    if (song.src !== "") playMusic();
                    else alert("Bài hát này chưa có file nhạc! Vui lòng tải thêm.");
                });
                playlistEl.appendChild(li);
            });
        }

        function playMusic() {
            if (!bgMusic.src || bgMusic.src.endsWith(window.location.host + "/")) {
                alert("Vui lòng chọn bài có sẵn file nhạc!");
                return;
            }
            bgMusic.play().then(() => {
                playPauseBtn.innerHTML = '<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
                diskIcon.style.animationPlayState = 'running';
            }).catch(e => console.log("Lỗi autoplay: ", e));
        }

        function pauseMusic() {
            bgMusic.pause();
            playPauseBtn.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
            diskIcon.style.animationPlayState = 'paused';
        }

        playPauseBtn.addEventListener('click', () => {
            if (bgMusic.paused) playMusic();
            else pauseMusic();
        });

        prevBtn.addEventListener('click', () => {
            currentSongIndex = (currentSongIndex - 1 + songs.length) % songs.length;
            loadSong(currentSongIndex);
            if (songs[currentSongIndex].src) playMusic();
        });

        nextBtn.addEventListener('click', () => {
            currentSongIndex = (currentSongIndex + 1) % songs.length;
            loadSong(currentSongIndex);
            if (songs[currentSongIndex].src) playMusic();
        });

        bgMusic.addEventListener('ended', () => {
            nextBtn.click();
        });

        // Tự động phát khi tương tác
        document.body.addEventListener('click', () => {
            if (!hasInteracted && bgMusic.paused) {
                hasInteracted = true;
                if (songs[currentSongIndex].src) playMusic();
            }
        }, { once: true });

        // Khởi tạo
        loadSong(currentSongIndex);

    </script>

    <!-- Modal xem ảnh phóng to -->
    <div id="imageLightbox" class="lightbox-modal" onclick="closeLightbox()">
        <img id="lightboxImg" src="" alt="Ảnh phóng to">
    </div>

    
    

</body>

</html>